# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O docker-compose.yml lê estas variáveis para provisionar o Postgres local
# (e, no docker-compose.yml da pasta Api, também a API em container).

POSTGRES_DB=freighthub
POSTGRES_USER=freighthub
POSTGRES_PASSWORD=freighthub_dev_password
POSTGRES_PORT=5432

# Chave-mestra (Base64, 32 bytes) para cifrar as credenciais de integração no banco.
# Gere com: openssl rand -base64 32
# Em produção, defina via variável de ambiente no seu provedor de deploy.
Credentials__EncryptionKey=

# Chave de assinatura do JWT do portal (mínimo 32 bytes). Gere com: openssl rand -base64 48
Jwt__SigningKey=

# Admin inicial criado no primeiro start (quando não há nenhum usuário).
Auth__InitialAdmin__Email=
Auth__InitialAdmin__Password=

# Nota: rodando a API com `dotnet run` (ASPNETCORE_ENVIRONMENT=Development), os
# valores acima já vêm preenchidos com defaults de desenvolvimento em
# appsettings.Development.json — não é obrigatório preencher este .env para
# rodar localmente. Ele só é necessário para subir via docker-compose (ambiente
# "Production") ou para usar valores diferentes dos defaults de dev.
